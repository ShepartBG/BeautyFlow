    "test:browser:mobile": "node --env-file=.env.test.local ./node_modules/@playwright/test/cli.js test tests/admin.spec.ts tests/public.spec.ts tests/booking-flow.spec.ts --project=mobile",
    "test:browser:report": "playwright show-report"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.108.2",
    "next": "15.5.25",
    "react": "19.2.7",
